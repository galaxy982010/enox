# ============================================================================
# ENOX — Premium Ebook Marketplace Environment Configuration
# Copy this file to .env.local and fill in your credentials before going live.
# NEVER commit .env.local or expose secret keys to NEXT_PUBLIC_* variables.
# ============================================================================

# 1. Application URL (used for canonical URLs, sitemaps, and signed download links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Server-Side Cryptographic Signing Secret (used for session tokens & short-lived download tokens)
ENOX_SERVER_SECRET=enox_dev_hmac_signing_secret_replace_in_production_2026

# 3. Supabase Configuration (Optional locally — falls back to persistent local relational DB until set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# STRICTLY SERVER-ONLY: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser
SUPABASE_SERVICE_ROLE_KEY=

# 4. Razorpay Payment Integration (INR)
# Public Key ID (safe to pass to Razorpay Checkout modal, or fetched from server)
RAZORPAY_KEY_ID=
# STRICTLY SERVER-ONLY: Used for creating Razorpay orders & verifying HMAC-SHA256 payment signatures
RAZORPAY_KEY_SECRET=
# STRICTLY SERVER-ONLY: Used for verifying x-razorpay-signature on raw webhook payloads
RAZORPAY_WEBHOOK_SECRET=

# 5. Developer / QA Signature Verification Sandbox (set to false in production)
ALLOW_QA_SIGNATURE_SANDBOX=true
